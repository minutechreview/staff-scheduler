# Retail Staff Scheduler — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ── Firebase (REQUIRED) ────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Telegram Notifications (OPTIONAL) ─────────────────────────────────────────
# Used by the in-app feedback button to post notifications to a Telegram chat.
# Leave blank to disable Telegram notifications (feedback still saves to Firestore).
# Get a bot token from @BotFather on Telegram.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# ── Email Domain Restriction (OPTIONAL) ───────────────────────────────────────
# Restrict login to a specific email domain (e.g. your-company.com).
# Leave blank to allow any email address.
VITE_ALLOWED_EMAIL_DOMAIN=your-company.com

# ── Role Bootstrapping (OPTIONAL) ─────────────────────────────────────────────
# Pre-assign special roles during onboarding for specific email addresses.
# Set VITE_DM_EMAIL to auto-assign District Manager role.
# Set VITE_ADMIN_EMAIL to auto-assign Admin role.
# Leave blank if you want all users to self-select their role during onboarding.
VITE_DM_EMAIL=
VITE_ADMIN_EMAIL=

# ── Cloud Functions (OPTIONAL) ────────────────────────────────────────────────
# Required only if deploying Firebase Cloud Functions (welcome email feature).
# Set via: firebase functions:secrets:set SMTP_USER
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@your-company.com
APP_URL=https://your-project-id.web.app
