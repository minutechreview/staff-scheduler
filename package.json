{
  "name": "relay-staff-scheduler",
  "private": true,
  "version": "0.1.0-local",
  "type": "module",
  "scripts": {
    "dev": "npm run build && python3 server/app.py",
    "start": "python3 server/app.py",
    "build": "vite build",
    "build:email-preview": "vite build --config vite.email-preview.config.js",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -v",
    "benchmark": "python3 tests/benchmark.py",
    "preview": "python3 server/app.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "lightningcss": "^1.32.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@humanfs/node": "0.16.8",
    "baseline-browser-mapping": "2.11.0",
    "brace-expansion": "1.1.21",
    "browserslist": "4.28.7",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2"
  }
}
